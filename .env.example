# Chép thành .env.local rồi điền. Không commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # chỉ dùng ở server
ALLOWED_EMAIL=                  # email duy nhất được đăng nhập
ANTHROPIC_API_KEY=              # chỉ dùng ở server (từ M2)
ANTHROPIC_MODEL=claude-sonnet-5-5
# Nhắc học (F16). Tạo khóa: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=              # chỉ dùng ở server
VAPID_SUBJECT=mailto:           # email liên hệ cho dịch vụ đẩy
CRON_SECRET=                    # chuỗi ngẫu nhiên dài; Supabase gửi kèm khi gọi /api/cron/remind
